// ══════════════════════════════════════════════════════════════════════════════
//  Verily Workbench config — ASAP snRNA-seq pipeline
//  Replaces nextflow.config (COSMOS-SENS/Singularity) for GCP/Google Batch
//
//  Key differences vs COSMOS-SENS config:
//    - Executor  : google-batch  (not SLURM)
//    - Containers: Docker images (not Singularity .sif files)
//    - Paths     : gs:// GCS URIs  (not /scale/gr01/ local paths)
//    - No clusterOptions (SLURM-specific)
// ══════════════════════════════════════════════════════════════════════════════

params {
    // ── I/O ────────────────────────────────────────────────────────────────────
    // Path to your samplesheet — upload it to ws_files first, then use the GCS URI:
    //   wb resource resolve ws_files  → gives you the gs:// bucket root
    //   e.g. gs://wb-lambent-papaya-979-ws-files/samplesheets/ASAP_samplesheet.xlsx
    // pmdbs_v3_gcs: set this to auto-build the samplesheet as pipeline step 0.
    // Leave null (or comment out) to supply samplesheet manually via --samplesheet.
    // Value comes from: wb resource describe --id=pmdbs-sc-rnaseq-v3 → GCS bucket name
    pmdbs_v3_gcs     = "gs://asap-crn-pmdbs-sc-rnaseq-collection-v3"

    // Fallback samplesheet path (used only when pmdbs_v3_gcs is null)
    samplesheet      = "gs://cloned-ws-files-wb-lambent-papaya-979/samplesheets/ASAP_samplesheet.xlsx"

    // Output directory — write to ws_files so results persist after the app closes
    outdir           = "gs://cloned-ws-files-wb-lambent-papaya-979/results_ASAP_verily"

    max_parallel     = 8

    // ── Ambient RNA correction ─────────────────────────────────────────────────
    // "soupx"      : SoupX via R (CPU)
    // "cellbender" : CellBender 0.3.0 (GPU — select an A100 machine type below)
    // "skip"       : no ambient correction (use when input is already CellBender-corrected)
    // pmdbs-sc-rnaseq-v3 ships cellbender_filtered.h5 → skip ambient correction
    ambient_tool     = "skip"

    cellbender_cuda            = true
    cellbender_expected_cells  = 0
    cellbender_total_droplets  = 25000
    cellbender_fpr             = "0.01"

    // ── Integration ────────────────────────────────────────────────────────────
    // "harmony" : Harmony (CPU, default)
    // "scvi"    : scVI-tools (GPU — select an A100 machine type below)
    integration_tool = "harmony"

    sex_filter       = "male"
    extra_filter     = ""

    // ── Genotype check ─────────────────────────────────────────────────────────
    genotype_check   = true
    skip_genotyping  = false

    // 1000 Genomes reference VCF — upload to ws_files or use a public GCS copy:
    //   gsutil cp /path/to/genome1K.phase3... gs://CHANGE_ME/refs/
    cellsnp_vcf      = "gs://cloned-ws-files-wb-lambent-papaya-979/refs/genome1K.phase3.SNP_AF5e2.chr1toX.hg38.vcf.gz"
    cellsnp_min_count   = 20
    cellsnp_min_called  = 500

    // ── Docker image names (from DockerHub) ────────────────────────────────────
    scrnaseq_img   = "pdeblas/scrnaseq:latest"
    rocker_img     = "pdeblas/rocker:latest"
    scvitools_img  = "pdeblas/scvitools:1.5.1-gpu"
    cellbender_img = "pdeblas/cellbender:0.3.0-gpu"
    cellsnp_img    = "quay.io/biocontainers/cellsnp-lite:1.2.3--ha0c3a46_6"
}


// ── Google Cloud / Google Batch ───────────────────────────────────────────────
google {
    project  = "wb-lambent-papaya-979"   // from: wb workspace describe → Google project
    location = "us-central1"             // from: terra-default-location property
}

// ── Per-process resource + container overrides ────────────────────────────────
process {
    executor     = "google-batch"
    errorStrategy = 'retry'
    maxRetries    = 1

    // Default machine type — overridden per process below
    machineType  = "n2-standard-8"

    withName: 'CREATE_SAMPLESHEET' {
        container   = params.scrnaseq_img
        cpus        = 1
        memory      = '4 GB'
        machineType = "n2-standard-2"
    }

    withName: 'PREPARE_SAMPLES' {
        container   = params.scrnaseq_img
        cpus        = 1
        memory      = '4 GB'
        machineType = "n2-standard-2"
    }

    withName: 'SOUPX' {
        container   = params.rocker_img
        cpus        = 4
        memory      = '24 GB'
        machineType = "n2-standard-8"
    }

    // CellBender — requires GPU. a2-highgpu-1g has 1× A100 40 GB.
    // Switch to a2-highgpu-2g if memory errors occur.
    withName: 'CELLBENDER' {
        container         = params.cellbender_img
        cpus              = 4
        memory            = '32 GB'
        machineType       = "a2-highgpu-1g"
        accelerator       = [request: 1, type: "nvidia-tesla-a100"]
    }

    withName: 'QC_PER_SAMPLE' {
        container   = params.scrnaseq_img
        cpus        = 4
        memory      = '64 GB'
        machineType = "n2-highmem-8"
    }

    withName: 'VALIDATE_SEX' {
        container   = params.scrnaseq_img
        cpus        = 2
        memory      = '64 GB'
        machineType = "n2-highmem-8"
    }

    // Harmony integration — high RAM node (100 GB+)
    // n2-highmem-16 gives 128 GB RAM
    withName: 'INTEGRATE_HARMONY' {
        container   = params.scrnaseq_img
        cpus        = 16
        memory      = '100 GB'
        machineType = "n2-highmem-16"
    }

    // scVI — GPU required
    withName: 'INTEGRATE_SCVI' {
        container         = params.scvitools_img
        cpus              = 8
        memory            = '64 GB'
        machineType       = "a2-highgpu-1g"
        accelerator       = [request: 1, type: "nvidia-tesla-a100"]
    }

    withName: 'CELLSNP' {
        container   = params.cellsnp_img
        cpus        = 8
        memory      = '16 GB'
        machineType = "n2-standard-8"
    }

    withName: 'COMPARE_GENOTYPES' {
        container   = params.scrnaseq_img
        cpus        = 4
        memory      = '16 GB'
        machineType = "n2-standard-4"
    }

    withName: 'REPLOT_GENOTYPES' {
        container   = params.scrnaseq_img
        cpus        = 2
        memory      = '8 GB'
        machineType = "n2-standard-2"
    }
}


// ── Docker ────────────────────────────────────────────────────────────────────
docker {
    enabled    = true
    runOptions = "--platform linux/amd64"
}

// Disable Singularity (was enabled in COSMOS-SENS config)
singularity.enabled = false


// ── Nextflow work directory (must be a GCS bucket) ────────────────────────────
// Set this on the command line with -w, or uncomment:
workDir = "gs://cloned-ws-files-wb-lambent-papaya-979/nextflow_work"


// ── Execution reports ─────────────────────────────────────────────────────────
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_report.html"   }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_dag.html"      }

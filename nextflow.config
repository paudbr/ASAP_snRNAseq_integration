// ══════════════════════════════════════════════════════════════════════════════
//  Custom config — ASAP snRNA-seq pipeline
//  Extends /scale/gr01/shared/nf-core/cosmo_sens_grp1_NFv24.config
// ══════════════════════════════════════════════════════════════════════════════

includeConfig '/scale/gr01/shared/nf-core/cosmos_sens_grp1_NFv24.config'

params {
    samplesheet      = "${projectDir}/ASAP_samplesheet.xlsx"
    outdir           = "results_ASAP"
    max_parallel     = 8

    // ── Ambient RNA correction ─────────────────────────────────────────────────
    // "soupx"      : SoupX via R (CPU, default)
    // "cellbender" : CellBender 0.3.0 (GPU recommended, much slower on CPU)
    // "skip"       : no ambient correction — use raw filtered counts
    ambient_tool     = "soupx"

    // CellBender tuning (only used when ambient_tool = "cellbender")
    cellbender_cuda            = true    // set false to run on CPU (≈10× slower)
    cellbender_expected_cells  = 0       // 0 = auto-detect from data
    cellbender_total_droplets  = 25000   // total droplets fed to the model
    cellbender_fpr             = "0.01"  // false positive rate for correction

    // ── Integration ────────────────────────────────────────────────────────────
    // "harmony" : Harmony (CPU, default)
    // "scvi"    : scVI-tools (GPU required)
    integration_tool = "harmony"

    // Sex filter applied at integration time: "all" | "M" | "F"
    sex_filter       = "all"

    // ── Metadata filters ───────────────────────────────────────────────────────
    // Applied in PREPARE_SAMPLES on top of the built-in hypoxia filter.
    // Syntax: "col1:val1,val2;col2:val3"  — empty string = no filter
    extra_filter     = ""

    // ── Genotype check (cellsnp-lite pseudo-bulk) ──────────────────────────────
    // Runs in parallel with the rest of the pipeline. Set false to skip.
    genotype_check       = true

    // Set true to skip cellsnp + VCF parsing and just regenerate the PDF
    // from an existing concordance_all_pairs.tsv in outdir/genotype_check/.
    skip_genotyping      = false

    // cellsnp-lite container + 1000 Genomes reference VCF (shared in cluster)
    cellsnp_sif          = "/scale/gr01/shared/jjakobsson/processed/SNPs/cellsnp-lite.sif"
    cellsnp_vcf          = "/scale/gr01/shared/jjakobsson/processed/SNPs/genome1K.phase3.SNP_AF5e2.chr1toX.hg38.vcf.gz"
    cellsnp_min_count    = 20     // min reads covering a SNP (pseudo-bulk total)
    cellsnp_min_called   = 500    // min callable sites for a confident comparison

    // ── Container paths ────────────────────────────────────────────────────────
    scrnaseq_sif    = "/home/paudbr/containers/scrnaseq_v2.sif"
    rocker_sif      = "/home/paudbr/containers/rocker_seurat_v2.sif"
    scvitools_sif   = "/home/paudbr/containers/scvitools_1.5.1-gpu.sif"
    cellbender_sif  = "/home/paudbr/containers/cellbender_1.2-gpu.sif"
}


// ── Per-process resource + container overrides ────────────────────────────────
process {
    errorStrategy = 'retry'
    maxRetries    = 1

    withName: 'PREPARE_SAMPLES' {
        container = params.scrnaseq_sif
        cpus      = 1
        memory    = '4 GB'
        time      = '15m'
    }

    withName: 'SOUPX' {
        container = params.rocker_sif
        cpus      = 4
        memory    = '24 GB'
        time      = '2h'
        maxForks  = params.max_parallel
    }

    // CellBender runs one sample per job on a GPU node.
    // Adjust --gres and partition to match your cluster GPU setup.
    // On COSMOS-SENS try: -p gpu or -p sens-gpu
    withName: 'CELLBENDER' {
        container      = params.cellbender_sif
        cpus           = 4
        memory         = '32 GB'
        time           = '4h'
        maxForks       = params.max_parallel
        clusterOptions = '-p sens-gpu '
    }

    withName: 'QC_PER_SAMPLE' {
        container = params.scrnaseq_sif
        cpus      = 4
        memory    = '64 GB'
        time      = '4h'
        maxForks  = params.max_parallel
    }

    withName: 'VALIDATE_SEX' {
        container = params.scrnaseq_sif
        cpus      = 2
        memory    = '64 GB'
        time      = '30m'
    }

    withName: 'INTEGRATE_HARMONY' {
        container      = params.scrnaseq_sif
        cpus           = 16
        memory         = '100 GB'
        time           = '12h'
        clusterOptions = '-p sens-xl'
    }

    withName: 'INTEGRATE_SCVI' {
        container      = params.scvitools_sif
        cpus           = 8
        memory         = '64 GB'
        time           = '6h'
        clusterOptions = '-p sens-gpu'
    }

    // cellsnp-lite: CPU-only, one sample per job, runs in parallel with QC
    withName: 'CELLSNP' {
        container = params.cellsnp_sif
        cpus      = 8
        memory    = '16 GB'
        time      = '4h'
        maxForks  = params.max_parallel
    }

    // compare_genotypes.py: single job after all CELLSNP jobs finish
    withName: 'COMPARE_GENOTYPES' {
        container = params.scrnaseq_sif
        cpus      = 4
        memory    = '16 GB'
        time      = '30m'
    }

    // Regenerate PDF only (skip_genotyping = true) — lightweight
    withName: 'REPLOT_GENOTYPES' {
        container = params.scrnaseq_sif
        cpus      = 2
        memory    = '8 GB'
        time      = '10m'
    }
}


// ── Execution reports ─────────────────────────────────────────────────────────
timeline { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_report.html"   }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/pipeline_dag.html"      }


// ── Singularity ───────────────────────────────────────────────────────────────
// --nv passes the host NVIDIA driver into the container (needed for GPU jobs).
// Harmless on CPU-only nodes.
singularity {
    enabled    = true
    runOptions = "--bind /scale/gr01/:/scale/gr01/ --nv"
}
